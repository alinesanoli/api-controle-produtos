{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "server=ALINE-LUCAS; database=WebApi; trusted_connection=true; trustservercertificate=true" //o trusted_connection=true é para usar a autenticação do windows, ou seja, o usuário logado no windows tem acesso ao banco de dados. Se quiser usar um usuário e senha específicos, use: Server=ALINE-LUCAS; Database=WebApi; User Id=seu_usuario; Password=sua_senha
  }
}
